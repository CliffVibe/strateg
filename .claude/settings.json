{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": false
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(python scripts/strat.py *)",
      "Bash(python3 scripts/strat.py *)",
      "Bash(py scripts/strat.py *)",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(python projects/*/work/calc/*.py)",
      "Bash(python3 projects/*/work/calc/*.py)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "WebSearch"
    ],
    "ask": [
      "WebFetch",
      "Bash(pip *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/strat.py\" hook session-start", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|WebSearch|WebFetch|Agent|Task",
        "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/strat.py\" hook protect", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "WebFetch|WebSearch|Read|Bash|PowerShell",
        "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/strat.py\" hook injection-scan", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/strat.py\" hook stop", "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/scripts/strat.py\" hook session-end", "timeout": 30 } ] }
    ]
  }
}
